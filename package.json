{
  "name": "dsh-agent-sdk-bridge",
  "displayName": "Agent SDK Bridge",
  "description": "DeepSeek Harness LLM adapter bridge for Qoder CN, Qoder International and Tencent CodeBuddy subscriptions. It reuses each provider's own official SDK and CLI login, shows available quota, and exposes per-provider settings pages with independent international and mainland login regions.",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "author": "k1-h2",
  "keywords": [
    "dsh-plugin",
    "dsh-agent-sdk-bridge",
    "agent-sdk-bridge",
    "deepseek-harness",
    "deepseek",
    "qoder",
    "qoder-cn",
    "qoder-international",
    "codebuddy",
    "codebuddy-code",
    "quota",
    "model-provider",
    "agent-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k1-h2/dsh-agent-sdk-bridge.git"
  },
  "homepage": "https://github.com/k1-h2/dsh-agent-sdk-bridge#readme",
  "bugs": {
    "url": "https://github.com/k1-h2/dsh-agent-sdk-bridge/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-rc.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": ">=1.8.5 <2",
    "@deepseek-ai/dsh-attachment": "^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@qoder-ai/qoder-agent-sdk": "^1.0.58",
    "@qodercn-ai/qodercn-agent-sdk": "^1.0.58",
    "@tencent-ai/agent-sdk": "^0.3.289",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cosmokit": "~1.8.5",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "build:clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit false --emitDeclarationOnly",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build:clean && npm run typecheck:client && npm run typecheck:test && npm test"
  }
}
